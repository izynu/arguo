# Evidence Ledger environment configuration
# Copy this file to .env and fill in values. Never commit real keys.

# Web search provider: "tavily" (default) or "offline" for fixture-backed runs
EVIDENCE_FIRST_SEARCH_PROVIDER=tavily

# Tavily API key (https://tavily.com). Required when search provider is tavily.
TAVILY_API_KEY=

# Model adapter: any OpenAI-compatible chat completions endpoint
# Examples: a GLM endpoint, OpenAI, a local server exposing /chat/completions
EVIDENCE_FIRST_MODEL_PROVIDER=openai-compatible
EVIDENCE_FIRST_MODEL_BASE_URL=
EVIDENCE_FIRST_MODEL_API_KEY=
EVIDENCE_FIRST_MODEL_NAME=
EVIDENCE_FIRST_MODEL_TEMPERATURE=0.2

# Optional: cap model calls per research run (cost control)
EVIDENCE_FIRST_MAX_MODEL_CALLS=24

# Optional: data directory for cache and run outputs (default: ./runs)
EVIDENCE_FIRST_OUTPUT_DIR=./runs

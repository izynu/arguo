{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arguo.dev/schemas/resource.schema.json",
  "title": "Arguo resource record",
  "description": "One research resource in the Arguo catalog. Every field is factual metadata about a real, publicly reachable resource. Never invent values: use null when unknown.",
  "type": "object",
  "required": [
    "id", "name", "canonical_url", "category", "description", "best_for",
    "resource_type", "publisher", "region", "language", "resource_access",
    "api_available", "official_source", "license", "date_added",
    "verification_status", "provenance", "tags"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$",
      "description": "Stable unique identifier, kebab-case."
    },
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "canonical_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "HTTPS canonical URL of the resource home page or primary entry point."
    },
    "category": { "type": "string", "description": "One key from data/categories.json." },
    "subcategory": { "type": ["string", "null"], "maxLength": 80 },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 320,
      "description": "Factual one or two sentence description. No hype, no em dashes, no emoji."
    },
    "best_for": {
      "type": "array",
      "items": { "type": "string", "maxLength": 60 },
      "minItems": 1,
      "maxItems": 4
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "database", "portal", "api", "archive", "repository", "library",
        "search-engine", "tool", "documentation", "dataset-registry",
        "journal", "registry", "standard", "preprint-server", "agency",
        "organization", "program"
      ]
    },
    "publisher": { "type": "string", "minLength": 2, "maxLength": 120 },
    "region": {
      "type": "string",
      "description": "\"global\" or a specific country or region name in English."
    },
    "language": { "type": "string", "description": "Primary interface language, ISO 639-1 code." },
    "resource_access": {
      "type": "string",
      "enum": ["open", "free-registration", "partial-open", "paid", "mixed"]
    },
    "api_available": { "type": "boolean" },
    "documentation_url": { "type": ["string", "null"], "pattern": "^https://|^$" },
    "official_source": {
      "type": "boolean",
      "description": "True when the publisher is the originating authority for the data or content."
    },
    "license": {
      "type": "string",
      "description": "SPDX identifier, short license name, or the literal string \"unknown\"."
    },
    "attribution_requirements": { "type": ["string", "null"], "maxLength": 200 },
    "access_requirements": { "type": ["string", "null"], "maxLength": 200 },
    "date_added": { "type": "string", "format": "date" },
    "last_checked": { "type": ["string", "null"], "format": "date", "description": "Date of last successful live check, null when never live-checked." },
    "verification_status": {
      "type": "string",
      "enum": ["verified", "documented", "community-submitted", "deprecated"],
      "description": "\"verified\" requires an actual live check. Seed records use \"documented\"."
    },
    "provenance": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "maxLength": 80 },
        "note": { "type": ["string", "null"], "maxLength": 300 }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "maxLength": 30 },
      "minItems": 1,
      "maxItems": 8
    },
    "status_notes": { "type": ["string", "null"], "maxLength": 300 }
  }
}
